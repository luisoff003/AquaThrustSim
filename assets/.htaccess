# AquaThrust assets — make sure updates are picked up and modules load.
# (Apache / LiteSpeed. Ignored by nginx, where the ?v= version in every URL still busts caches.)

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    # Always ask the server whether the file changed (cheap 304 when it did not).
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
